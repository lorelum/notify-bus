{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["security:only-security-updates"],
  "enabledManagers": ["bun"],
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "vulnerabilityFixStrategy": "lowest"
  }
}
